[
 {
  "id": "story-four-masters",
  "title": "四个师傅和一辆抖动的车",
  "scene": "城西高架桥下有一间修车行，铁皮屋顶，四个工位，一台老举升机。门口挂着一块木牌：什么都修，修不好不要钱。车行只有一个学徒，叫小周，十九岁，手快胆子大，就是没师傅。",
  "roles": [
   {
    "role": "小周",
    "maps_to": "学生模型",
    "duty": "自己采样轨迹，自己承担后果"
   },
   {
    "role": "陈师傅",
    "maps_to": "电路域教师",
    "duty": "只在电路相关的 token 上说话"
   },
   {
    "role": "吴师傅",
    "maps_to": "发动机域教师",
    "duty": "只在发动机相关的 token 上说话"
   },
   {
    "role": "郑师傅",
    "maps_to": "结构域教师",
    "duty": "只在钣金/结构 token 上说话"
   },
   {
    "role": "许师傅",
    "maps_to": "漆面域教师",
    "duty": "只在漆面 token 上说话"
   },
   {
    "role": "阿珍",
    "maps_to": "路由器",
    "duty": "决定这一辆车该叫哪位师傅"
   },
   {
    "role": "老马",
    "maps_to": "验证器",
    "duty": "不修车，只判定修得对不对"
   },
   {
    "role": "老算",
    "maps_to": "token 预算",
    "duty": "记录每个师傅每次开口的工位费"
   }
  ],
  "plot": [
   {
    "act": "开张",
    "text": "开张第一天，来了一辆混动车，怠速时方向盘抖。小周先拆火花塞、再看节气门、最后泡喷油嘴，忙了四十分钟车还是抖。四个师傅蹲在门口谁也不动手——规矩是学徒不动手，师傅不开口。小周拆到第三遍，陈师傅才说：点火时序偏了半个齿。小周调了，车不抖了。这就是第一条规矩：车是学徒自己拆的，师傅只在他拆到的地方给一句话——on-policy。"
   },
   {
    "act": "会诊",
    "text": "第二辆车冷启动困难。陈师傅说加两毫秒喷油，吴师傅说减一点进气补偿，两个人方向相反。小周问听谁的，阿珍按车型手册把他派给了吴师傅，车更难启动了。陈师傅说：我们看的不是同一张工单。两个师傅都没错，错的是把两句话当成一句话——梯度冲突。解法不是让谁闭嘴，而是让每个人只在自己看得见的那一段路上说话。"
   },
   {
    "act": "派错单",
    "text": "第三辆是事故车，纵梁撞弯。阿珍按「事故车优先喷漆组」把许师傅派来，许师傅讲了一下午漆面色差，小周记了两页笔记，纵梁还是弯的。老马试车回来说：这车跑高速会吃胎。阿珍改派单规则：不按车型派，按「这辆车现在卡在哪一步」派——路由。路由错了，学徒学的不是本事，是话术。"
   },
   {
    "act": "旧照片与账本",
    "text": "入冬接了一辆跑了三十万公里的老越野，四十多道工序跨三个星期。小周每天拍照存档，吴师傅指着一张三天前的照片说气门间隙不对，小周说那是拆之前的照片——状态错位。老算把账本拍在桌上：四个师傅轮流说话，每句话都占一次举升机，电费翻倍，学徒只多学了三道工序。于是定下四条规矩：on-policy、token 级域监督、路由、验证。"
   }
  ],
  "mapping": [
   {
    "concept": "学生自采样",
    "entity": "小周自己拆车"
   },
   {
    "concept": "多教师 token 级监督",
    "entity": "四个师傅各说自家那一段"
   },
   {
    "concept": "梯度冲突",
    "entity": "陈师傅与吴师傅方向相反"
   },
   {
    "concept": "路由器",
    "entity": "阿珍按「卡在哪一步」派单"
   },
   {
    "concept": "状态对齐",
    "entity": "师傅看的是学徒动手时的那张工单"
   },
   {
    "concept": "token 预算",
    "entity": "老算的工位费账本"
   },
   {
    "concept": "验证器",
    "entity": "老马试车"
   },
   {
    "concept": "异步与陈旧",
    "entity": "夜班看录好的工单"
   }
  ],
  "boundaries": [
   "真实的教师不会只在一颗螺丝上说话——它给的是整条轨迹上每个 token 的分布，粒度比修车细得多。",
   "车修坏了可以返工，模型训坏了要重跑；比喻里没有「不可逆」这一层。",
   "师傅人数在故事里固定是四个，真实 MOPD 可以增删教师，也可以让一个教师覆盖多个域。",
   "修车行里师傅和学徒看的是同一辆车；模型里教师参数量可能是学生的十倍，这个容量差在故事里没有对应物。"
  ],
